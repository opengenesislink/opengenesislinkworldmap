# Environment variables: configure in PHP-FPM, Apache, Nginx or systemd
OGL_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=opensim;charset=utf8mb4
OGL_DB_USER=opensim_reader
OGL_DB_PASS=CHANGE_ME
OGL_CENTER_X=5000
OGL_CENTER_Y=5000
# meters: OpenSimulator usually stores locX/locY in meters
# regions: older grids can store grid-cell coordinates directly
OGL_COORD_UNIT=meters
